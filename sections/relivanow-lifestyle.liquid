{% liquid
  assign image_count = 0
  if section.settings.image_one != blank
    assign image_count = image_count | plus: 1
  endif
  if section.settings.image_two != blank
    assign image_count = image_count | plus: 1
  endif
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
%}

{% if section.settings.enable_section and image_count > 0 %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
  <div class="section-background color-custom-{{ section.id }}"></div>
  <section class="relivanow-lifestyle section section--{{ section.settings.section_width }} color-custom-{{ section.id }} spacing-style" style="{% render 'spacing-style', settings: section.settings %} --lifestyle-ratio: {{ section.settings.aspect_ratio }}; --lifestyle-overlay: {{ section.settings.overlay_color }}; --lifestyle-overlay-opacity: {{ overlay_opacity }}; --lifestyle-text: {{ section.settings.text_color }};">
    <div class="relivanow-lifestyle__grid relivanow-lifestyle__grid--{{ image_count }}{% if section.settings.reverse_images %} relivanow-lifestyle__grid--reverse{% endif %}">
      {% if section.settings.image_one != blank %}
        <figure class="relivanow-lifestyle__media">
          {% assign image_one_alt = section.settings.image_one_alt | default: section.settings.image_one.alt | default: section.settings.heading %}
          {{ section.settings.image_one | image_url: width: 2000 | image_tag: widths: '480, 750, 1000, 1500, 2000', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: image_one_alt }}
        </figure>
      {% endif %}
      {% if section.settings.image_two != blank %}
        <figure class="relivanow-lifestyle__media">
          {% assign image_two_alt = section.settings.image_two_alt | default: section.settings.image_two.alt | default: section.settings.heading %}
          {{ section.settings.image_two | image_url: width: 2000 | image_tag: widths: '480, 750, 1000, 1500, 2000', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: image_two_alt }}
        </figure>
      {% endif %}
      {% if section.settings.heading != blank or section.settings.text != blank or section.settings.cta_label != blank %}
        <div class="relivanow-lifestyle__overlay relivanow-lifestyle__overlay--position-{{ section.settings.content_position }} relivanow-lifestyle__overlay--align-{{ section.settings.alignment }}">
          <div class="relivanow-lifestyle__content">
            {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
            {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
            {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
              <a class="button" href="{{ section.settings.cta_link | escape }}">{{ section.settings.cta_label | escape }}</a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </section>
{% elsif section.settings.enable_section and request.design_mode %}
  <section class="section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {% render 'relivanow-preview-placeholder', label: 'Lifestyle / Product in Use — select one or two approved images' %}
  </section>
{% endif %}

{% stylesheet %}
  .relivanow-lifestyle__grid {
    position: relative;
    display: grid;
    min-width: 0;
    background: var(--color-surface);
    overflow: hidden;
  }

  .relivanow-lifestyle__grid--2 {
    grid-template-columns: minmax(0, 1fr);
  }

  .relivanow-lifestyle__grid--reverse .relivanow-lifestyle__media:first-child {
    order: 2;
  }

  .relivanow-lifestyle__media {
    min-width: 0;
    margin: 0;
    aspect-ratio: var(--lifestyle-ratio);
    overflow: hidden;
  }

  .relivanow-lifestyle__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .relivanow-lifestyle__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    padding: clamp(24px, 5vw, 72px);
    color: var(--lifestyle-text);
    pointer-events: none;
  }

  .relivanow-lifestyle__overlay::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, var(--lifestyle-overlay), transparent 80%);
    opacity: var(--lifestyle-overlay-opacity);
    content: '';
  }

  .relivanow-lifestyle__overlay--position-top { align-items: flex-start; }
  .relivanow-lifestyle__overlay--position-center { align-items: center; }
  .relivanow-lifestyle__overlay--position-bottom { align-items: flex-end; }
  .relivanow-lifestyle__overlay--align-left { justify-content: flex-start; text-align: left; }
  .relivanow-lifestyle__overlay--align-center { justify-content: center; text-align: center; }
  .relivanow-lifestyle__overlay--align-right { justify-content: flex-end; text-align: right; }

  .relivanow-lifestyle__content {
    display: grid;
    gap: var(--gap-sm);
    width: min(100%, 40rem);
    pointer-events: auto;
  }

  .relivanow-lifestyle__content h2,
  .relivanow-lifestyle__content .rte > :first-child,
  .relivanow-lifestyle__content .rte > :last-child {
    margin-block: 0;
  }

  .relivanow-lifestyle__content h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .relivanow-lifestyle__content .button {
    width: fit-content;
    min-height: 44px;
  }

  .relivanow-lifestyle__overlay--align-center .button { margin-inline: auto; }
  .relivanow-lifestyle__overlay--align-right .button { margin-inline-start: auto; }

  @media screen and (min-width: 750px) {
    .relivanow-lifestyle__grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RELIVANOW lifestyle",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "enable_section", "label": "Show section", "default": true },
    { "type": "image_picker", "id": "image_one", "label": "Image one" },
    { "type": "text", "id": "image_one_alt", "label": "Image one alt text" },
    { "type": "image_picker", "id": "image_two", "label": "Image two" },
    { "type": "text", "id": "image_two_alt", "label": "Image two alt text" },
    { "type": "checkbox", "id": "reverse_images", "label": "Reverse image order", "default": false },
    { "type": "select", "id": "aspect_ratio", "label": "Image aspect ratio", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "16 / 9", "label": "Landscape" }], "default": "4 / 5" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "select", "id": "content_position", "label": "Content position", "options": [{ "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" }], "default": "bottom" },
    { "type": "select", "id": "alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#171817" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [{ "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" }], "default": "full-width" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 128, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 128, "step": 8, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "RELIVANOW lifestyle", "category": "Product" }]
}
{% endschema %}
