{% liquid
  assign faq_records = product.metafields.relivanow.faqs.value
  assign confirmed_faq_count = 0
%}

{% capture faq_items %}
  {% for faq in faq_records %}
    {% liquid
      assign faq_status = faq.verification_status.value | upcase
      assign faq_question = faq.question.value
      assign faq_answer = faq.answer
      if faq_status != 'CONFIRMED' or faq_question == blank or faq_answer == blank
        continue
      endif
      assign confirmed_faq_count = confirmed_faq_count | plus: 1
      if confirmed_faq_count > 10
        break
      endif
      assign open_this_faq = false
      if section.settings.open_first and confirmed_faq_count == 1
        assign open_this_faq = true
      endif
    %}
    {% capture faq_children %}
      <details
        class="details"
        data-testid="accordion-details"
        {% unless section.settings.allow_multiple %}name="relivanow-faq-{{ section.id }}"{% endunless %}
        {% if section.settings.open_first and confirmed_faq_count == 1 %}open{% endif %}
      >
        <summary class="details__header">
          <span>{{ faq_question | escape }}</span>
          <span class="svg-wrapper icon-plus" aria-hidden="true">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
        </summary>
        <div class="details-content rte">{{ faq_answer | metafield_tag }}</div>
      </details>
    {% endcapture %}
    {% render 'accordion-custom-component', children: faq_children, open_by_default_on_desktop: open_this_faq, open_by_default_on_mobile: open_this_faq %}
  {% endfor %}
{% endcapture %}

{% assign faq_items = faq_items | strip %}
{% if section.settings.enable_section and confirmed_faq_count >= 6 and faq_items != blank %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
  <div class="section-background color-custom-{{ section.id }}"></div>
  <section class="relivanow-faq section section--{{ section.settings.section_width }} color-custom-{{ section.id }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {% render 'relivanow-section-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.intro, alignment: section.settings.alignment %}
    <div class="relivanow-faq__items accordion accordion--plus accordion--dividers">{{ faq_items }}</div>
  </section>
  {% if section.settings.enable_schema %}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {% assign schema_index = 0 %}
          {% for faq in faq_records %}
            {% assign faq_status = faq.verification_status.value | upcase %}
            {% if faq_status != 'CONFIRMED' or faq.question.value == blank or faq.answer == blank %}{% continue %}{% endif %}
            {% assign schema_index = schema_index | plus: 1 %}
            {% if schema_index > 10 %}{% break %}{% endif %}
            {% unless schema_index == 1 %},{% endunless %}
            {
              "@type": "Question",
              "name": {{ faq.question.value | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ faq.answer | metafield_tag | strip_html | strip_newlines | json }}
              }
            }
          {% endfor %}
        ]
      }
    </script>
  {% endif %}
{% elsif section.settings.enable_section and request.design_mode %}
  <section class="section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {% render 'relivanow-preview-placeholder', label: 'FAQ — link six to ten confirmed relivanow_faq records with approved answers' %}
  </section>
{% endif %}

{% render 'accordion-styles' %}

{% stylesheet %}
  .relivanow-faq__items {
    max-width: 56rem;
    margin-inline: auto;
  }

  .relivanow-faq__items .details {
    border-block-start: 1px solid var(--color-border);
  }

  .relivanow-faq__items accordion-custom:last-child .details {
    border-block-end: 1px solid var(--color-border);
  }

  .relivanow-faq__items .details__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--gap-sm);
    align-items: center;
    min-height: 64px;
    padding-block: var(--padding-sm);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: var(--font-weight-semibold);
  }

  .relivanow-faq__items .details-content {
    padding-block-end: var(--padding-md);
    padding-inline-end: 48px;
    color: var(--color-muted);
  }

  .relivanow-faq__items .details-content .metafield-rich_text_field > :first-child,
  .relivanow-faq__items .details-content .metafield-rich_text_field > :last-child {
    margin-block: 0;
  }

  .relivanow-faq__items details[open] .icon-plus {
    transform: rotate(45deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .relivanow-faq__items .icon-plus {
      transition: transform var(--animation-speed-fast) var(--animation-easing);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RELIVANOW FAQ",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "enable_section", "label": "Show section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "richtext", "id": "intro", "label": "Introductory text" },
    { "type": "checkbox", "id": "allow_multiple", "label": "Allow multiple open items", "default": false },
    { "type": "checkbox", "id": "open_first", "label": "Open first item", "default": false },
    { "type": "checkbox", "id": "enable_schema", "label": "Output FAQ structured data", "info": "Keep disabled when an app or another theme component owns FAQ schema.", "default": false },
    { "type": "select", "id": "alignment", "label": "Header alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "center" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [{ "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" }], "default": "page-width" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#F7F7F4" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 128, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 128, "step": 8, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "RELIVANOW FAQ", "category": "Product" }]
}
{% endschema %}
