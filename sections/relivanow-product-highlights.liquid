{% liquid
  assign valid_highlight_count = 0
  for block in section.blocks
    if block.type == 'highlight' and block.settings.verification_status == 'CONFIRMED' and block.settings.image != blank and block.settings.image_alt != blank and block.settings.title != blank and block.settings.text != blank
      assign valid_highlight_count = valid_highlight_count | plus: 1
    endif
  endfor
  assign section_ready = false
  if section.settings.heading != blank and valid_highlight_count == 4
    assign section_ready = true
  endif
%}

{% if section_ready or request.design_mode %}
  <section class="rn-highlights section section--page-width color-{{ section.settings.color_scheme }}" style="--rn-gap: {{ section.settings.gap }}px">
    {% if section_ready %}
      <header class="rn-highlights__header">
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}
      </header>
      <div class="rn-highlights__rail" role="region" aria-label="{{ section.settings.heading | escape }}">
        {% for block in section.blocks %}
          {% if block.type == 'highlight' and block.settings.verification_status == 'CONFIRMED' and block.settings.image != blank and block.settings.image_alt != blank and block.settings.title != blank and block.settings.text != blank %}
            <article class="rn-highlights__card" {{ block.shopify_attributes }}>
              {{ block.settings.image | image_url: width: 1000 | image_tag: widths: '320, 480, 640, 800, 1000', sizes: '(min-width: 750px) 25vw, 82vw', alt: block.settings.image_alt, loading: 'lazy' }}
              <div class="rn-highlights__overlay">
                <h3>{{ block.settings.title | escape }}</h3>
                <div class="rte">{{ block.settings.text }}</div>
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="rn-highlights__placeholder">Add a heading and exactly four confirmed highlights with approved media and copy.</div>
    {% endif %}
  </section>
{% endif %}

{% stylesheet %}
  .rn-highlights { padding-block: clamp(32px, 6vw, 72px); }
  .rn-highlights__placeholder { padding: 24px; border: 1px dashed currentColor; text-align: center; }
  .rn-highlights__header { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, .7fr); align-items: end; gap: 24px; padding-block-end: 24px; border-block-end: 1px solid rgb(var(--color-foreground-rgb) / .18); }
  .rn-highlights__header h2 { margin: 0; overflow-wrap: anywhere; }
  .rn-highlights__rail { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--rn-gap); margin-block-start: 24px; overflow-x: auto; scroll-snap-type: x mandatory; }
  .rn-highlights__card { position: relative; min-width: 0; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 14px; scroll-snap-align: start; background: #222; color: #fff; }
  .rn-highlights__card > img { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .rn-highlights__card::after { content: ''; position: absolute; inset: 32% 0 0; background: linear-gradient(transparent, rgb(0 0 0 / .82)); pointer-events: none; }
  .rn-highlights__overlay { position: absolute; z-index: 1; inset: auto 18px 18px; min-width: 0; }
  .rn-highlights__overlay h3 { margin: 0 0 8px; color: inherit; overflow-wrap: anywhere; }
  .rn-highlights__overlay .rte { color: inherit; overflow-wrap: anywhere; }
  @media (hover: hover) { .rn-highlights__card:hover > img { transform: scale(1.025); } }
  @media (max-width: 989px) { .rn-highlights__rail { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 749px) {
    .rn-highlights__header { grid-template-columns: 1fr; }
    .rn-highlights__rail { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 82%; }
  }
  @media (prefers-reduced-motion: reduce) { .rn-highlights *, .rn-highlights *::before, .rn-highlights *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; animation-duration: .01ms !important; } }
{% endstylesheet %}

{% schema %}
{
  "name": "RELIVANOW highlights",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "intro", "label": "Optional introduction" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "gap", "label": "Card gap", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 14 }
  ],
  "blocks": [
    {
      "type": "highlight", "name": "Confirmed highlight",
      "settings": [
        { "type": "select", "id": "verification_status", "label": "Content approval status", "options": [{ "value": "UNCONFIRMED", "label": "Unconfirmed" }, { "value": "CONFIRMED", "label": "Confirmed" }], "default": "UNCONFIRMED" },
        { "type": "image_picker", "id": "image", "label": "Approved image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "RELIVANOW highlights" }]
}
{% endschema %}
