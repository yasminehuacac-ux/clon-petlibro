<script src="{{ 'relivanow-complete-look.js' | asset_url }}" type="module" fetchpriority="low"></script>
{% render 'buy-buttons-styles' %}

{% liquid
  assign valid_product_count = 0
  assign seen_product_ids = '|'
  for block in section.blocks
    assign product = block.settings.product
    assign product_is_valid = false
    if block.type == 'product' and block.settings.verification_status == 'CONFIRMED' and product != blank and product.available and product.featured_image != blank
      if block.settings.image_override == blank or block.settings.image_alt != blank
        assign product_is_valid = true
      endif
    endif
    if product_is_valid
      assign product_token = '|' | append: product.id | append: '|'
      unless seen_product_ids contains product_token
        assign seen_product_ids = seen_product_ids | append: product.id | append: '|'
        assign valid_product_count = valid_product_count | plus: 1
      endunless
    endif
  endfor
  assign section_ready = false
  if section.settings.heading != blank and valid_product_count == 2
    assign section_ready = true
  endif
%}

{% if section_ready or request.design_mode %}
  <section class="rn-complete section section--page-width color-{{ section.settings.color_scheme }}" style="--rn-gap: {{ section.settings.gap }}px">
    {% if section_ready %}
      <h2>{{ section.settings.heading | escape }}</h2>
      <div class="rn-complete__grid">
        {% assign rendered_product_ids = '|' %}
        {% for block in section.blocks %}
          {% assign product = block.settings.product %}
          {% assign product_is_valid = false %}
          {% if block.type == 'product' and block.settings.verification_status == 'CONFIRMED' and product != blank and product.available and product.featured_image != blank %}
            {% if block.settings.image_override == blank or block.settings.image_alt != blank %}{% assign product_is_valid = true %}{% endif %}
          {% endif %}
          {% assign product_token = '|' | append: product.id | append: '|' %}
          {% if product_is_valid %}
            {% unless rendered_product_ids contains product_token %}
              {% assign rendered_product_ids = rendered_product_ids | append: product.id | append: '|' %}
              {% assign selected_variant = product.selected_or_first_available_variant %}
              {% assign card_image = block.settings.image_override | default: selected_variant.featured_image | default: product.featured_image %}
              {% assign card_alt = block.settings.image_alt | default: card_image.alt | default: product.title %}
              {% assign form_id = 'RnCompleteForm-' | append: section.id | append: '-' | append: block.id %}
              <relivanow-complete-look-card class="rn-complete__card" {{ block.shopify_attributes }}>
                <a class="rn-complete__media" href="{{ product.url }}">
                  {% if block.settings.image_override != blank %}
                    {{ card_image | image_url: width: 1200 | image_tag: widths: '240, 360, 480, 720, 960, 1200', sizes: '(min-width: 750px) 50vw, 50vw', alt: card_alt, loading: 'lazy', class: 'rn-complete__image' }}
                  {% else %}
                    {{ card_image | image_url: width: 1200 | image_tag: widths: '240, 360, 480, 720, 960, 1200', sizes: '(min-width: 750px) 50vw, 50vw', alt: card_alt, loading: 'lazy', class: 'rn-complete__image rn-complete__image--native' }}
                  {% endif %}
                </a>
                <div class="rn-complete__details">
                  <a class="rn-complete__title" href="{{ product.url }}"><h3>{{ product.title | escape }}</h3></a>
                  <div class="rn-complete__price" data-complete-look-price>{% if selected_variant != blank %}{{ selected_variant.price | money }}{% else %}{{ product.price | money }}{% endif %}</div>
                  <div class="rn-complete__availability" data-complete-look-availability>{{ 'content.inventory_in_stock' | t }}</div>
                  {% if product.has_only_default_variant == false %}
                    <div class="rn-complete__options">
                      {% for product_option in product.options_with_values %}
                        <fieldset>
                          <legend>{{ product_option.name | escape }}: <span data-selected-option-position="{{ product_option.position }}">{{ product_option.selected_value | escape }}</span></legend>
                          <div class="rn-complete__values">
                            {% for product_option_value in product_option.values %}
                              <label class="rn-complete__option{% if product_option_value.swatch != blank %} rn-complete__option--swatch{% endif %}" title="{{ product_option_value.name | escape }}">
                                <input
                                  type="radio"
                                  name="RnComplete-{{ section.id }}-{{ block.id }}-{{ product_option.position }}"
                                  value="{{ product_option_value.name | escape }}"
                                  data-relivanow-option
                                  data-option-position="{{ product_option.position }}"
                                  {% if product_option_value.selected %}checked{% endif %}
                                >
                                {% if product_option_value.swatch != blank %}
                                  {% render 'swatch', swatch: product_option_value.swatch, variant_image: product_option_value.variant.featured_media, mode: 'unscaled', label: product_option_value.name %}
                                  <span class="visually-hidden">{{ product_option_value.name | escape }}</span>
                                {% else %}
                                  <span>{{ product_option_value.name | escape }}</span>
                                {% endif %}
                              </label>
                            {% endfor %}
                          </div>
                        </fieldset>
                      {% endfor %}
                    </div>
                  {% endif %}
                  <product-form-component
                    class="rn-complete__form"
                    data-section-id="{{ section.id }}"
                    data-product-id="{{ product.id }}"
                    data-variant-source="form"
                    on:submit="/handleSubmit"
                  >
                    <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                    {% form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
                      <input type="hidden" name="id" ref="variantId" value="{{ selected_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      {% render 'add-to-cart-button', can_add_to_cart: selected_variant.available, product: product, class: 'rn-complete__submit' %}
                    {% endform %}
                  </product-form-component>
                  <script type="application/json" data-variants-json>{{ product.variants | json }}</script>
                  <div hidden>
                    {% for variant in product.variants %}
                      {% assign variant_image = variant.featured_image | default: product.featured_image %}
                      <span
                        data-variant-state
                        data-variant-id="{{ variant.id }}"
                        data-price="{{ variant.price | money | escape }}"
                        data-availability="{% if variant.available %}{{ 'content.inventory_in_stock' | t | escape }}{% else %}{{ 'content.unavailable' | t | escape }}{% endif %}"
                        data-image-url="{{ variant_image | image_url: width: 1200 }}"
                        data-image-alt="{{ variant_image.alt | default: product.title | escape }}"
                      ></span>
                    {% endfor %}
                  </div>
                </div>
              </relivanow-complete-look-card>
            {% endunless %}
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="rn-complete__placeholder">Select exactly two distinct, confirmed, available products with approved media.</div>
    {% endif %}
  </section>
{% endif %}

{% stylesheet %}
  .rn-complete { padding-block: clamp(32px, 6vw, 72px); }
  .rn-complete__placeholder { padding: 24px; border: 1px dashed currentColor; text-align: center; }
  .rn-complete > h2 { margin-block: 0 26px; overflow-wrap: anywhere; }
  .rn-complete__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--rn-gap); }
  .rn-complete__card { display: flex; min-width: 0; flex-direction: column; }
  .rn-complete__media { display: block; overflow: hidden; aspect-ratio: 4 / 3; border-radius: 14px; background: rgb(var(--color-foreground-rgb) / .05); }
  .rn-complete__image { width: 100%; height: 100%; object-fit: cover; }
  .rn-complete__details { display: flex; flex: 1; min-width: 0; flex-direction: column; padding-block: 16px; }
  .rn-complete__title { color: inherit; text-decoration: none; }
  .rn-complete__title h3 { margin-block: 0 6px; overflow-wrap: anywhere; }
  .rn-complete__price { font-weight: 650; }
  .rn-complete__availability { margin-block-start: 4px; font-size: .9em; opacity: .72; }
  .rn-complete__options { display: grid; gap: 14px; margin-block: 18px; }
  .rn-complete__options fieldset { min-width: 0; padding: 0; border: 0; }
  .rn-complete__options legend { margin-block-end: 7px; font-size: .9em; overflow-wrap: anywhere; }
  .rn-complete__values { display: flex; flex-wrap: wrap; gap: 7px; }
  .rn-complete__option { position: relative; display: grid; min-width: 44px; min-height: 44px; place-items: center; padding: 7px 10px; border: 1px solid rgb(var(--color-foreground-rgb) / .3); border-radius: 999px; cursor: pointer; overflow-wrap: anywhere; }
  .rn-complete__option input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .rn-complete__option:has(input:checked) { border-color: currentColor; box-shadow: inset 0 0 0 1px currentColor; }
  .rn-complete__option:has(input:focus-visible) { outline: 2px solid currentColor; outline-offset: 2px; }
  .rn-complete__option--swatch { width: 44px; padding: 5px; }
  .rn-complete__option--swatch .swatch { width: 30px; height: 30px; }
  .rn-complete__form { display: block; margin-block-start: auto; }
  .rn-complete__form form, .rn-complete__submit { width: 100%; }
  .rn-complete__submit { min-height: 44px; }
  @media (max-width: 749px) {
    .rn-complete__grid { gap: min(var(--rn-gap), 10px); }
    .rn-complete__media { aspect-ratio: 1; }
    .rn-complete__details { padding-block: 10px; }
    .rn-complete__options { gap: 10px; margin-block: 12px; }
    .rn-complete__option { padding-inline: 7px; font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .rn-complete *, .rn-complete *::before, .rn-complete *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; } }
{% endstylesheet %}

{% schema %}
{
  "name": "RELIVANOW complete look",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "gap", "label": "Column gap", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "product", "name": "Confirmed product",
      "settings": [
        { "type": "select", "id": "verification_status", "label": "Relationship approval status", "options": [{ "value": "UNCONFIRMED", "label": "Unconfirmed" }, { "value": "CONFIRMED", "label": "Confirmed" }], "default": "UNCONFIRMED" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image_override", "label": "Optional approved image override" },
        { "type": "text", "id": "image_alt", "label": "Override image alt text" }
      ]
    }
  ],
  "presets": [{ "name": "RELIVANOW complete look" }]
}
{% endschema %}
