<script src="{{ 'marquee.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% liquid
  assign valid_item_count = 0
  for block in section.blocks
    if block.settings.text != blank
      assign valid_item_count = valid_item_count | plus: 1
    endif
  endfor
%}

{% if valid_item_count > 0 %}
  <marquee-component
    class="relivanow-promotion-marquee"
    style="
      --relivanow-marquee-background: {{ section.settings.background_color }};
      --relivanow-marquee-color: {{ section.settings.text_color }};
      --relivanow-marquee-gap: {{ section.settings.desktop_gap }}px;
      --relivanow-marquee-mobile-gap: {{ section.settings.mobile_gap }}px;
      --relivanow-marquee-padding-block: {{ section.settings.desktop_padding }}px;
      --relivanow-marquee-mobile-padding-block: {{ section.settings.mobile_padding }}px;
      --marquee-gap: {{ section.settings.desktop_gap }}px;
      --marquee-direction: {{ section.settings.movement_direction }};
    "
    data-speed-factor="25"
    data-speed-mode="distance"
    data-seconds-per-100="{{ section.settings.seconds_per_100 }}"
    data-pause-on-hover="{{ section.settings.pause_on_hover }}"
    data-movement-direction="{{ section.settings.movement_direction }}"
    aria-label="{{ section.settings.accessibility_label | escape }}"
  >
    <div class="relivanow-promotion-marquee__wrapper" ref="wrapper">
      <div class="relivanow-promotion-marquee__content" ref="content">
        <div class="relivanow-promotion-marquee__items" ref="marqueeItems[]">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              {% if block.settings.link != blank %}
                <a
                  class="relivanow-promotion-marquee__item"
                  href="{{ block.settings.link }}"
                  {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.text | escape }}
                </a>
              {% else %}
                <span class="relivanow-promotion-marquee__item" {{ block.shopify_attributes }}>
                  {{ block.settings.text | escape }}
                </span>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </marquee-component>
{% elsif request.design_mode %}
  <div class="relivanow-reference-empty" data-relivanow-editor-placeholder>
    Add at least one promotion item to preview this disabled reference section.
  </div>
{% endif %}

{% stylesheet %}
  .relivanow-promotion-marquee {
    display: block;
    overflow: hidden;
    padding-block: var(--relivanow-marquee-padding-block);
    color: var(--relivanow-marquee-color);
    background: var(--relivanow-marquee-background);
  }

  .relivanow-promotion-marquee__wrapper,
  .relivanow-promotion-marquee__content,
  .relivanow-promotion-marquee__items {
    display: flex;
    width: max-content;
    min-width: max-content;
    gap: var(--marquee-gap);
    align-items: center;
  }

  .relivanow-promotion-marquee__item {
    color: inherit;
    font: inherit;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }

  .relivanow-promotion-marquee__item:is(:hover, :focus-visible) {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .relivanow-promotion-marquee:not([data-disabled]) .relivanow-promotion-marquee__wrapper {
      animation: relivanow-marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @media screen and (max-width: 749px) {
    .relivanow-promotion-marquee {
      --marquee-gap: var(--relivanow-marquee-mobile-gap);
      padding-block: var(--relivanow-marquee-mobile-padding-block);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .relivanow-promotion-marquee__wrapper {
      transform: none;
    }
  }

  @keyframes relivanow-marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RELIVANOW promotion",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 12,
  "blocks": [
    {
      "type": "item",
      "name": "Promotion item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "Open in new tab", "default": false }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Store updates" },
    {
      "type": "select",
      "id": "movement_direction",
      "label": "Movement direction",
      "options": [
        { "value": "normal", "label": "Left" },
        { "value": "reverse", "label": "Right" }
      ],
      "default": "normal"
    },
    { "type": "range", "id": "seconds_per_100", "label": "Seconds per 100 pixels", "min": 1, "max": 10, "step": 1, "default": 2 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true },
    { "type": "range", "id": "desktop_gap", "label": "Desktop gap", "min": 8, "max": 120, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 8, "max": 80, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "desktop_padding", "label": "Desktop vertical padding", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile vertical padding", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 16 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#171817" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "RELIVANOW promotion" }]
}
{% endschema %}
