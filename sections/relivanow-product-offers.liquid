{% liquid
  assign valid_product_count = 0
  for block in section.blocks
    if block.settings.product != blank
      assign valid_product_count = valid_product_count | plus: 1
    endif
  endfor

  assign should_render = false
  if section.settings.campaign_status == 'CONFIRMED' and section.settings.campaign_heading != blank and section.settings.campaign_image != blank and section.settings.campaign_image_alt != blank and section.settings.campaign_cta_label != blank and section.settings.campaign_link != blank and valid_product_count >= 2
    assign should_render = true
  endif
%}

{% if should_render %}
  <section
    class="relivanow-product-offers section section--page-width"
    style="--relivanow-offers-bg: {{ section.settings.background_color }}; --relivanow-offers-color: {{ section.settings.text_color }}; --relivanow-offers-gap: {{ section.settings.gap }}px;"
  >
    {% if section.settings.heading != blank %}<h2 class="relivanow-product-offers__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
    <div class="relivanow-product-offers__rail" role="list">
      <article class="relivanow-product-offers__campaign" role="listitem">
        <a href="{{ section.settings.campaign_link }}">
          {{
            section.settings.campaign_image
            | image_url: width: 1400
            | image_tag:
              widths: '480, 720, 960, 1200, 1400',
              sizes: '(min-width: 990px) 34vw, 82vw',
              loading: 'lazy',
              alt: section.settings.campaign_image_alt
          }}
          <div class="relivanow-product-offers__campaign-copy">
            <h3>{{ section.settings.campaign_heading | escape }}</h3>
            {% if section.settings.campaign_text != blank %}<p>{{ section.settings.campaign_text | escape }}</p>{% endif %}
            <span class="button">{{ section.settings.campaign_cta_label | escape }}</span>
          </div>
        </a>
      </article>

      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          <article class="relivanow-product-offers__product" role="listitem" {{ block.shopify_attributes }}>
            <a href="{{ product.url }}">
              <div class="relivanow-product-offers__media">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 1000
                    | image_tag:
                      widths: '320, 480, 720, 1000',
                      sizes: '(min-width: 990px) 22vw, 72vw',
                      loading: 'lazy',
                      alt: product.featured_image.alt | default: product.title
                  }}
                {% endif %}
                {% if block.settings.label_status == 'CONFIRMED' and block.settings.custom_label != blank %}
                  <span class="relivanow-product-offers__label">{{ block.settings.custom_label | escape }}</span>
                {% endif %}
              </div>
              <div class="relivanow-product-offers__product-copy">
                <h3>{{ product.title | escape }}</h3>
                <p class="relivanow-product-offers__price">
                  <span>{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <s>{{ product.compare_at_price | money }}</s>
                  {% endif %}
                </p>
              </div>
            </a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </section>
{% elsif request.design_mode %}
  <div class="relivanow-reference-empty" data-relivanow-editor-placeholder>
    Product offers are fail-closed. Confirm the campaign tile and select at least two real Shopify products.
  </div>
{% endif %}

{% stylesheet %}
  .relivanow-product-offers {
    padding-block: clamp(3rem, 7vw, 6rem);
    color: var(--relivanow-offers-color);
    background: var(--relivanow-offers-bg);
  }

  .relivanow-product-offers__heading {
    margin: 0 0 2rem;
    font-size: clamp(2rem, 4vw, 4rem);
    text-wrap: balance;
  }

  .relivanow-product-offers__rail {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--relivanow-offers-gap);
  }

  .relivanow-product-offers__rail > * {
    min-width: 0;
    scroll-snap-align: start;
  }

  .relivanow-product-offers__rail a {
    color: inherit;
    text-decoration: none;
  }

  .relivanow-product-offers__campaign {
    grid-column: span 2;
  }

  .relivanow-product-offers__campaign > a,
  .relivanow-product-offers__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #f0f1ed;
  }

  .relivanow-product-offers__campaign img,
  .relivanow-product-offers__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .relivanow-product-offers__campaign-copy {
    position: absolute;
    inset: auto 1.5rem 1.5rem;
    padding: 1rem;
    color: #fff;
    background: rgb(0 0 0 / 45%);
  }

  .relivanow-product-offers__campaign-copy :is(h3, p),
  .relivanow-product-offers__product-copy :is(h3, p) {
    margin: 0;
  }

  .relivanow-product-offers__product-copy {
    display: grid;
    gap: 0.4rem;
    padding-top: 0.9rem;
  }

  .relivanow-product-offers__price {
    display: flex;
    gap: 0.5rem;
  }

  .relivanow-product-offers__label {
    position: absolute;
    inset: 0.75rem auto auto 0.75rem;
    padding: 0.35rem 0.6rem;
    color: #171817;
    background: #d9ff43;
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media screen and (max-width: 749px) {
    .relivanow-product-offers__rail {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 72%;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: x mandatory;
    }

    .relivanow-product-offers__campaign {
      grid-column: auto;
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RELIVANOW product offers",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 8,
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "label_status", "label": "Custom label status", "info": "Enter CONFIRMED only after label approval." },
        { "type": "text", "id": "custom_label", "label": "Approved custom label" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Section heading" },
    { "type": "text", "id": "campaign_status", "label": "Campaign status", "info": "Enter CONFIRMED only after campaign approval." },
    { "type": "image_picker", "id": "campaign_image", "label": "Approved campaign image" },
    { "type": "text", "id": "campaign_image_alt", "label": "Campaign image alt text" },
    { "type": "text", "id": "campaign_heading", "label": "Approved campaign heading" },
    { "type": "textarea", "id": "campaign_text", "label": "Approved campaign text" },
    { "type": "text", "id": "campaign_cta_label", "label": "Approved campaign button label" },
    { "type": "url", "id": "campaign_link", "label": "Campaign link" },
    { "type": "range", "id": "gap", "label": "Card gap", "min": 4, "max": 32, "step": 2, "unit": "px", "default": 12 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F7F7F4" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#171817" }
  ],
  "presets": [{ "name": "RELIVANOW product offers" }]
}
{% endschema %}
