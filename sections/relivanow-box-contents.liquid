{% liquid
  assign box_item_records = product.metafields.relivanow.box_items.value
  assign confirmed_box_item_count = 0
%}

{% capture structured_box_items %}
  {% for item in box_item_records %}
    {% liquid
      assign item_status = item.verification_status.value | upcase
      assign item_title = item.title.value
      assign item_quantity = item.quantity.value
      if item_status != 'CONFIRMED' or item_title == blank or item_quantity == blank or item_quantity < 1
        continue
      endif
      assign confirmed_box_item_count = confirmed_box_item_count | plus: 1
      assign item_image = item.image.value.preview_image
      if item_image == blank
        assign item_image = item.icon.value.preview_image
      endif
      assign item_alt = item.alt_text.value | default: item_title
    %}
    <li class="relivanow-box-contents__card">
      <div class="relivanow-box-contents__media{% if item_image == blank %} relivanow-box-contents__media--icon{% endif %}">
        {% if item_image != blank %}
          {{ item_image | image_url: width: 640 | image_tag: widths: '160, 240, 360, 480, 640', sizes: '(min-width: 750px) 22vw, 40vw', loading: 'lazy', alt: item_alt }}
        {% else %}
          <svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: 'box' %}</svg>
        {% endif %}
      </div>
      <div class="relivanow-box-contents__item-copy">
        <h3>{{ item_title | escape }}</h3>
        <span aria-label="Quantity {{ item_quantity }}">×{{ item_quantity }}</span>
      </div>
    </li>
  {% endfor %}
{% endcapture %}

{% capture simple_box_items %}
  {% if confirmed_box_item_count == 0 %}
    {% for item_text in product.metafields.relivanow.box_contents.value %}
      {% if item_text == blank %}{% continue %}{% endif %}
      {% assign confirmed_box_item_count = confirmed_box_item_count | plus: 1 %}
      <li class="relivanow-box-contents__card">
        <div class="relivanow-box-contents__media relivanow-box-contents__media--icon">
          <svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: 'box' %}</svg>
        </div>
        <div class="relivanow-box-contents__item-copy"><h3>{{ item_text | escape }}</h3></div>
      </li>
    {% endfor %}
  {% endif %}
{% endcapture %}

{% assign structured_box_items = structured_box_items | strip %}
{% assign simple_box_items = simple_box_items | strip %}
{% if section.settings.enable_section and confirmed_box_item_count > 0 %}
  {% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}
  <div class="section-background color-custom-{{ section.id }}"></div>
  <section class="relivanow-box-contents section section--{{ section.settings.section_width }} color-custom-{{ section.id }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {% render 'relivanow-section-header', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.intro, alignment: section.settings.alignment %}
    <div class="relivanow-box-contents__layout{% if section.settings.overview_image != blank %} relivanow-box-contents__layout--with-image{% endif %}">
      {% if section.settings.overview_image != blank %}
        <div class="relivanow-box-contents__overview">
          {% assign overview_alt = section.settings.overview_image_alt | default: section.settings.overview_image.alt | default: section.settings.heading %}
          {{ section.settings.overview_image | image_url: width: 1400 | image_tag: widths: '480, 750, 1000, 1400', sizes: '(min-width: 750px) 45vw, 100vw', loading: 'lazy', alt: overview_alt }}
        </div>
      {% endif %}
      <ul class="relivanow-box-contents__list" role="list">
        {% if structured_box_items != blank %}{{ structured_box_items }}{% else %}{{ simple_box_items }}{% endif %}
      </ul>
    </div>
  </section>
{% elsif section.settings.enable_section and request.design_mode %}
  <section class="section section--{{ section.settings.section_width }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {% render 'relivanow-preview-placeholder', label: 'What’s in the Box — add confirmed relivanow.box_items records or the confirmed relivanow.box_contents list' %}
  </section>
{% endif %}

{% stylesheet %}
  .relivanow-box-contents__layout,
  .relivanow-box-contents__list {
    display: grid;
    gap: var(--gap-md);
    min-width: 0;
  }

  .relivanow-box-contents__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .relivanow-box-contents__overview {
    aspect-ratio: 4 / 3;
    border-radius: var(--style-border-radius-sm);
    background: var(--color-surface);
    overflow: hidden;
  }

  .relivanow-box-contents__overview img,
  .relivanow-box-contents__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .relivanow-box-contents__card {
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-sm);
    background: var(--color-background);
    overflow: hidden;
  }

  .relivanow-box-contents__media {
    aspect-ratio: 1;
    background: var(--color-surface);
    overflow: hidden;
  }

  .relivanow-box-contents__media--icon {
    display: grid;
    place-items: center;
    color: var(--color-brand);
  }

  .relivanow-box-contents__media--icon svg {
    width: 40px;
    height: 40px;
  }

  .relivanow-box-contents__item-copy {
    display: flex;
    gap: var(--gap-xs);
    align-items: baseline;
    justify-content: space-between;
    padding: var(--padding-sm);
  }

  .relivanow-box-contents__item-copy h3 {
    min-width: 0;
    margin: 0;
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .relivanow-box-contents__item-copy span {
    color: var(--color-muted);
    font-weight: var(--font-weight-semibold);
  }

  @media screen and (min-width: 750px) {
    .relivanow-box-contents__layout--with-image {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RELIVANOW box contents",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "checkbox", "id": "enable_section", "label": "Show section", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What’s in the box" },
    { "type": "richtext", "id": "intro", "label": "Introductory text" },
    { "type": "image_picker", "id": "overview_image", "label": "Overview image" },
    { "type": "text", "id": "overview_image_alt", "label": "Overview image alt text" },
    { "type": "select", "id": "alignment", "label": "Header alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "select", "id": "section_width", "label": "Width", "options": [{ "value": "page-width", "label": "Page" }, { "value": "full-width", "label": "Full" }], "default": "page-width" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FFFFFF" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 128, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 128, "step": 8, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "RELIVANOW box contents", "category": "Product" }]
}
{% endschema %}
