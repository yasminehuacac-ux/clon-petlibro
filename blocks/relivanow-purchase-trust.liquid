{% liquid
  assign product_resource = closest.product
  assign shipping_policy = product_resource.metafields.relivanow.shipping_policy.value
  assign return_policy = product_resource.metafields.relivanow.return_policy.value
  assign warranty_policy = product_resource.metafields.relivanow.warranty_policy.value

  assign shipping_policy_url = ''
  if shop.shipping_policy.body != blank
    assign shipping_policy_url = shop.shipping_policy.url
  endif

  assign return_policy_url = ''
  if shop.refund_policy.body != blank
    assign return_policy_url = shop.refund_policy.url
  endif

  capture policy_items
    render 'relivanow-policy-item', policy: shipping_policy, expected_kind: 'shipping', policy_url: shipping_policy_url
    render 'relivanow-policy-item', policy: return_policy, expected_kind: 'return', policy_url: return_policy_url
    render 'relivanow-policy-item', policy: warranty_policy, expected_kind: 'warranty'
  endcapture

  assign policy_items = policy_items | strip
%}

{% if policy_items != blank %}
  <div
    class="relivanow-purchase-trust spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <ul class="relivanow-purchase-trust__list" role="list">
      {{ policy_items }}
    </ul>
  </div>
{% elsif request.design_mode %}
  <div
    class="relivanow-purchase-trust spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% render 'relivanow-preview-placeholder', label: 'Confirmed trust badges preview' %}
  </div>
{% endif %}

{% stylesheet %}
  .relivanow-purchase-trust__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .relivanow-purchase-trust__item {
    display: inline-flex;
    gap: var(--gap-3xs);
    align-items: center;
    min-height: 36px;
    padding: var(--padding-3xs) var(--padding-xs);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
  }

  .relivanow-purchase-trust__title {
    color: currentColor;
    font-weight: 600;
    font-size: var(--font-paragraph-small--size);
    line-height: 1.2;
  }

  .relivanow-purchase-trust__icon {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    color: var(--color-brand);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RELIVANOW purchase trust",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "RELIVANOW purchase trust"
    }
  ]
}
{% endschema %}
