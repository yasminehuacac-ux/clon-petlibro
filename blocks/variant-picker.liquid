

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product %}
{% endunless %}

{% schema %}
{
  "name": "t:names.product_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.type"
    },
    {
      "type": "select",
      "id": "variant_style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "dropdowns",
          "label": "t:options.dropdowns"
        },
        {
          "value": "buttons",
          "label": "t:options.buttons"
        }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:settings.swatches",
      "default": true
    },
    {
      "type": "header",
      "content": "Visual purchase selectors"
    },
    {
      "type": "checkbox",
      "id": "enable_visual_color_swatches",
      "label": "Enable visual color swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_visual_style_cards",
      "label": "Enable visual style cards",
      "default": true
    },
    {
      "type": "text",
      "id": "visual_style_option_names",
      "label": "Style option names",
      "default": "Style, Model, Configuration",
      "visible_if": "{{ block.settings.enable_visual_style_cards }}"
    },
    {
      "type": "checkbox",
      "id": "show_style_price",
      "label": "Show style price",
      "default": true,
      "visible_if": "{{ block.settings.enable_visual_style_cards }}"
    },
    {
      "type": "checkbox",
      "id": "show_style_compare_at",
      "label": "Show style compare-at price",
      "default": true,
      "visible_if": "{{ block.settings.enable_visual_style_cards and block.settings.show_style_price }}"
    },
    {
      "type": "checkbox",
      "id": "show_style_badges",
      "label": "Show approved style badges",
      "default": true,
      "visible_if": "{{ block.settings.enable_visual_style_cards }}"
    },
    {
      "type": "range",
      "id": "style_card_image_size",
      "label": "Style card image size",
      "min": 64,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96,
      "visible_if": "{{ block.settings.enable_visual_style_cards }}"
    },
    {
      "type": "header",
      "content": "Color swatch mapping"
    },
    {
      "type": "select",
      "id": "default_color_display_mode",
      "label": "Default color display mode",
      "info": "Product metafield color_display_mode overrides this setting.",
      "options": [
        {
          "value": "swatch_only",
          "label": "Swatch only"
        },
        {
          "value": "swatch_and_name",
          "label": "Swatch and name"
        }
      ],
      "default": "swatch_only",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "text",
      "id": "color_swatch_name_1",
      "label": "Mapping 1 — option value name",
      "default": "White",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "color",
      "id": "color_swatch_color_1",
      "label": "Mapping 1 — swatch color",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "text",
      "id": "color_swatch_name_2",
      "label": "Mapping 2 — option value name",
      "default": "Black",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "color",
      "id": "color_swatch_color_2",
      "label": "Mapping 2 — swatch color",
      "default": "#000000",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "text",
      "id": "color_swatch_name_3",
      "label": "Mapping 3 — option value name",
      "default": "Cloud White",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "color",
      "id": "color_swatch_color_3",
      "label": "Mapping 3 — swatch color",
      "default": "#FFFFFF",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "text",
      "id": "color_swatch_name_4",
      "label": "Mapping 4 — option value name",
      "default": "Graphite",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "color",
      "id": "color_swatch_color_4",
      "label": "Mapping 4 — swatch color",
      "default": "#323433",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "text",
      "id": "color_swatch_name_5",
      "label": "Mapping 5 — option value name",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "color",
      "id": "color_swatch_color_5",
      "label": "Mapping 5 — swatch color",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "text",
      "id": "color_swatch_name_6",
      "label": "Mapping 6 — option value name",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "color",
      "id": "color_swatch_color_6",
      "label": "Mapping 6 — swatch color",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "text",
      "id": "color_swatch_name_7",
      "label": "Mapping 7 — option value name",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "color",
      "id": "color_swatch_color_7",
      "label": "Mapping 7 — swatch color",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "text",
      "id": "color_swatch_name_8",
      "label": "Mapping 8 — option value name",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "color",
      "id": "color_swatch_color_8",
      "label": "Mapping 8 — swatch color",
      "visible_if": "{{ block.settings.enable_visual_color_swatches }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "option_label_text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default",
      "alpha": true
    },
    {
      "type": "select",
      "id": "variant_style_class",
      "label": "t:settings.variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "info": "t:info.edit_variants_in_theme_settings"
    },
    {
      "type": "color",
      "id": "custom_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style_class == 'custom' }}"
    },
    {
      "type": "select",
      "id": "selected_variant_style_class",
      "label": "t:settings.selected_variant_button_style",
      "options": [
        {
          "value": "default",
          "label": "t:options.default"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.variant_style == 'buttons' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_selected_variant_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.variant_style == 'buttons' and block.settings.selected_variant_style_class == 'custom' }}"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_variant_picker",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
